generator client {
  provider      = "prisma-client-js"
  // "native"              → matches whatever machine runs `prisma generate` (macOS in dev)
  // "debian-openssl-3.0.x" → Ubuntu 22.04 (Render production)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooled — used by the app at runtime
  directUrl = env("DIRECT_URL")         // direct — used by prisma migrate/push
}

model Template {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  imageUrl    String
  width       Int
  height      Int
  category    TemplateCategory
  trendLabel  TrendLabel       @default(CLASSIC)
  trendScore  Float            @default(0)
  tags        String[]
  // Array of { id, x, y, w, h, defaultText, fontSize, align }
  textRegions Json
  usageCount  Int              @default(0)
  isPublic    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  memes Meme[]

  @@index([category])
  @@index([trendScore(sort: Desc)])
  @@index([trendLabel])
  @@index([usageCount(sort: Desc)])
}

model Meme {
  id          String   @id @default(cuid())
  shortId     String   @unique @default(cuid())
  templateId  String?
  imageUrl    String
  // Full Fabric.js JSON snapshot — enables re-editing and remixing
  canvasState Json
  width       Int
  height      Int
  isPublic    Boolean  @default(true)
  likeCount   Int      @default(0)
  remixCount  Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())

  template Template? @relation(fields: [templateId], references: [id])

  remixOf Remix?  @relation("RemixTarget")
  remixes Remix[] @relation("SourceMeme")

  @@index([shortId])
  @@index([createdAt(sort: Desc)])
  @@index([likeCount(sort: Desc)])
  @@index([isPublic, createdAt(sort: Desc)])
}

model Remix {
  id           String   @id @default(cuid())
  sourceMemeId String
  newMemeId    String   @unique
  createdAt    DateTime @default(now())

  sourceMeme Meme @relation("SourceMeme", fields: [sourceMemeId], references: [id])
  newMeme    Meme @relation("RemixTarget", fields: [newMemeId], references: [id])

  @@index([sourceMemeId])
}

enum TemplateCategory {
  REACTION
  CORPORATE
  ANIME
  GAMING
  BOLLYWOOD
  INDIAN
  SPORTS
  ABSURDIST
  WHOLESOME
  POLITICAL
  OTHER
}

enum TrendLabel {
  RISING
  HOT
  DEAD
  CLASSIC
}
