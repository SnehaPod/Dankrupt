# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Node modules (rebuilt from scratch inside Docker) ─────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Next.js build artefacts ───────────────────────────────────────────────────
.next
out

# ── Environment files ─────────────────────────────────────────────────────────
# Secrets are injected by Railway at runtime — never bake them into the image.
.env
.env.*
!.env.example

# ── Prisma local dev database ─────────────────────────────────────────────────
prisma/dev.db
prisma/dev.db-journal

# ── Testing / coverage ────────────────────────────────────────────────────────
coverage
.nyc_output

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docs / misc ───────────────────────────────────────────────────────────────
README.md
*.md
!prisma/migrations/**/*.sql
